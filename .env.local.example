# Supabase (entorno dev) — copiar a .env.local y completar con los valores reales.
# No commitear .env.local ni credenciales reales (ver AGENTS.md: cero secretos en el repositorio).
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

