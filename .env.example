# ==============================================================================
# APSys — Variables de Entorno de Configuración y Producción
# ==============================================================================

# Supabase — URL y claves de acceso de la API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Supabase — Clave con rol de servicio (exclusiva del backend/servidor, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Entorno de la aplicación
NEXT_PUBLIC_APP_URL=https://apsys.tu-dominio.com
NODE_ENV=production
